a just in time compiler for the exo scheduling language.
also includes microgpt: an end-to-end ML framework benchmark, from python down to assembly.

// currently being ported to xDSL:
// https://github.com/xdslproject/xdsl/tree/main/xdsl/jit


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


# exojit

usage:

    $ uv run exojit example.py --mlir
    $ uv run exojit example.py --c
    $ uv run example.py


how it works:

      Exo Python source
          v
      Exo LoopIR
          v
    - - - - - - - - - - - - - xDSL
      MLIR module
          v
      MLIR LLVM dialect
          v
    - - - - - - - - - - - - - xDSL JIT backend (llvmlite MCJIT)
      Native code


example (example.py):

    from exo import *
    from exo.API import Procedure
    from exo.stdlib.scheduling import divide_loop, fission, reorder_loops, simplify, unroll_loop

    from exojit import jit


    def optimize_matmul(p: Procedure) -> Procedure:
        p = fission(p, p.find("for k in _: _").before(), n_lifts=2)
        p = reorder_loops(p, "j k")
        p = divide_loop(p, "j #1", 4, ["jo", "ji"], perfect=True)
        p = unroll_loop(p, "ji")
        return simplify(p)


    @jit(optimize=optimize_matmul)
    def matmul(out: f32[32, 32] @ DRAM, A: f32[32, 32] @ DRAM, B: f32[32, 32] @ DRAM):
        for i in seq(0, 32):
            for j in seq(0, 32):
                out[i, j] = 0.0
                for k in seq(0, 32):
                    out[i, j] += A[i, k] * B[k, j]


to learn more about the exo language, check out:
https://github.com/exo-lang/exo/blob/main/docs/README.md


